<root>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/tactic_editor.js" />
        <include src="file://{resources}/scripts/custom_game/shop.js" />
    </scripts>
    <styles>
        <include src="file://{resources}/styles/custom_game/rpg_hud.css" />
    </styles>

    <Panel id="RPGRoot" hittest="false">
        <Panel id="TacticEditor" class="Window" hittest="true">
            <Label class="WindowTitle" text="行动规则" />
            <Label class="Hint" text="动作 → 仅限目标 → 优先目标 → 使用条件" />
            <Panel id="RuleRows" flow-children="down" />
        </Panel>

        <Panel id="RPGShop" class="Window" hittest="true">
            <Panel class="HeaderRow">
                <Label class="WindowTitle" text="装备商店" />
                <Label class="Gold" text="{d:rpg_gold}" />
            </Panel>
            <Label class="Hint" text="购买结果由服务端验证，物品先进入虚拟仓库" />
            <Panel id="ShopItems" flow-children="right-wrap" />
            <Panel id="WarehouseItems" flow-children="right-wrap" />
        </Panel>
    </Panel>
</root>
