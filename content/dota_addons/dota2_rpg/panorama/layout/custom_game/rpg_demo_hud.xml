<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/rpg_demo_hud.css" />
		<include src="file://{resources}/styles/custom_game/issue_fixes_ui.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/panorama_rule_sync.js" />
		<include src="file://{resources}/scripts/custom_game/issue_fixes_ui.js" />
		<include src="file://{resources}/scripts/custom_game/rpg_demo_hud.js" />
	</scripts>
	<snippets>
		<snippet name="RpgConditionEditor">
			<Panel class="ConditionEditor">
				<Panel class="ConditionTop">
					<Button id="ConditionSelect" class="ConditionSelect">
						<Label id="ConditionValue" class="ConditionValue" />
						<Label class="SelectChevron" text="v" />
					</Button>
					<Panel id="ThresholdControls" class="ThresholdControls">
						<TextEntry id="ThresholdEntry" class="ThresholdEntry" text="50" maxchars="3" />
						<Label id="PercentLabel" class="PercentLabel" text="%" />
					</Panel>
					<Button id="EffectSelect" class="EffectSelect Hidden">
						<Label id="EffectValue" class="EffectValue" />
						<Label class="SelectChevron" text="v" />
					</Button>
				</Panel>
				<Panel id="ConditionMenu" class="ConditionMenu Hidden">
					<Button id="AlwaysOption" class="ConditionOption" value="always"><Label text="#dota2_rpg_condition_always" /></Button>
					<Button id="SelfHpPctOption" class="ConditionOption" value="self_hp_pct_lte"><Label text="#dota2_rpg_condition_self_hp_pct_lte" /></Button>
					<Button id="SelfManaPctOption" class="ConditionOption" value="self_mana_pct_gte"><Label text="#dota2_rpg_condition_self_mana_pct_gte" /></Button>
					<Button id="EnemyCountOption" class="ConditionOption" value="alive_enemy_count_gte"><Label text="#dota2_rpg_condition_alive_enemy_count_gte" /></Button>
					<Button id="BattleTimeOption" class="ConditionOption" value="elapsed_gte"><Label text="#dota2_rpg_condition_elapsed_gte" /></Button>
					<Button id="SelfDamagedOption" class="ConditionOption" value="self_recently_damaged"><Label text="#dota2_rpg_condition_self_recently_damaged" /></Button>
					<Button id="AllyDamagedOption" class="ConditionOption" value="any_ally_recently_damaged"><Label text="#dota2_rpg_condition_any_ally_recently_damaged" /></Button>
					<Button id="AllyDeathOption" class="ConditionOption" value="dead_ally_count_gte"><Label text="#dota2_rpg_condition_dead_ally_count_gte" /></Button>
				</Panel>
				<Panel id="EffectMenu" class="EffectMenu Hidden">
					<Button id="MagicImmuneOption" class="EffectOption" value="magic_immune"><Label text="#dota2_rpg_effect_magic_immune" /></Button>
					<Button id="StunnedOption" class="EffectOption" value="stunned"><Label text="#dota2_rpg_effect_stunned" /></Button>
					<Button id="SilencedOption" class="EffectOption" value="silenced"><Label text="#dota2_rpg_effect_silenced" /></Button>
					<Button id="RootedOption" class="EffectOption" value="rooted"><Label text="#dota2_rpg_effect_rooted" /></Button>
				</Panel>
				<Panel class="TargetTop">
					<Button id="TargetAttrSelect" class="TargetSelect TargetAttrSelect">
						<Label id="TargetAttrValue" class="TargetValue" />
						<Label class="SelectChevron" text="v" />
					</Button>
					<Button id="TargetSideSelect" class="TargetSelect TargetSideSelect">
						<Label id="TargetSideValue" class="TargetValue" />
						<Label class="SelectChevron" text="v" />
					</Button>
				</Panel>
				<Panel id="TargetAttrMenu" class="TargetMenu Hidden">
					<Button class="TargetOption" value="hp"><Label text="#dota2_rpg_target_attr_hp" /></Button>
					<Button class="TargetOption" value="hp_pct"><Label text="#dota2_rpg_target_attr_hp_pct" /></Button>
					<Button class="TargetOption" value="armor"><Label text="#dota2_rpg_target_attr_armor" /></Button>
					<Button class="TargetOption" value="attack"><Label text="#dota2_rpg_target_attr_attack" /></Button>
					<Button class="TargetOption" value="mr"><Label text="#dota2_rpg_target_attr_mr" /></Button>
					<Button class="TargetOption" value="distance"><Label text="#dota2_rpg_target_attr_distance" /></Button>
					<Button class="TargetOption" value="casting"><Label text="#dota2_rpg_target_attr_casting" /></Button>
					<Button class="TargetOption" value="boss"><Label text="#dota2_rpg_target_attr_boss" /></Button>
					<Button class="TargetOption" value="healer"><Label text="#dota2_rpg_target_attr_healer" /></Button>
					<Button class="TargetOption" value="controlled"><Label text="#dota2_rpg_target_attr_controlled" /></Button>
				</Panel>
				<Panel id="TargetSideMenu" class="TargetMenu Hidden">
					<Button class="TargetOption" value="enemy_highest"><Label text="#dota2_rpg_target_side_enemy_highest" /></Button>
					<Button class="TargetOption" value="enemy_lowest"><Label text="#dota2_rpg_target_side_enemy_lowest" /></Button>
					<Button class="TargetOption" value="ally_highest"><Label text="#dota2_rpg_target_side_ally_highest" /></Button>
					<Button class="TargetOption" value="ally_lowest"><Label text="#dota2_rpg_target_side_ally_lowest" /></Button>
					<Button class="TargetOption" value="nearest"><Label text="#dota2_rpg_target_side_nearest" /></Button>
					<Button class="TargetOption" value="farthest"><Label text="#dota2_rpg_target_side_farthest" /></Button>
					<Button class="TargetOption" value="self"><Label text="#dota2_rpg_target_self" /></Button>
</Panel>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="RpgDemoHudRoot" hittest="false">
		<Panel id="BattleHeader">
			<Label id="BattleTitle" text="#dota2_rpg_battle_title" />
			<Label id="LevelProgress" text="1/20" />
			<Label id="BuildTag" text="#dota2_rpg_build_tag" />
			<Label id="BattleStatus" text="#dota2_rpg_status_preparing" />
		</Panel>

		<Panel id="RadiantEditor" class="TeamEditor RadiantEditor" hittest="true">
			<Panel class="TeamHeader">
				<Panel class="TeamIdentity">
					<Label class="TeamName" text="#dota2_rpg_radiant_logic" />
					<Label id="RadiantTeamLevel" class="TeamLevel" text="#dota2_rpg_level_30" />
					<Label id="RadiantSelectedHero" class="SelectedHeroName" />
				</Panel>
				<Panel id="RadiantHeroStrip" class="HeroStrip" />
				<Button id="RadiantCollapseButton" class="CollapseButton">
					<Label id="RadiantCollapseLabel" class="CollapseGlyph" text="&lt;" />
				</Button>
			</Panel>
			<Panel id="RadiantEditorBody" class="EditorBody" flow-children="down">
				<Panel class="ColumnHeader">
					<Label class="ActionColumn" text="#dota2_rpg_action_column" />
					<Label class="ConditionColumn" text="#dota2_rpg_condition_column" />
					<Label class="ForceColumn" text="#dota2_rpg_force_column" />
				</Panel>
				<Panel id="RadiantRulesViewport" class="RulesViewport">
					<Panel id="RadiantRules" class="RulesContainer" hittest="true" hittestchildren="true" />
					<Panel id="RadiantRulesScrollRail" class="RulesScrollRail" hittest="true">
						<Button id="RadiantRulesScrollUp" class="RulesScrollButton"><Label text="▲" /></Button>
						<Panel id="RadiantRulesScrollTrack" class="RulesScrollTrack">
							<Panel id="RadiantRulesScrollThumb" class="RulesScrollThumb" />
						</Panel>
						<Button id="RadiantRulesScrollDown" class="RulesScrollButton"><Label text="▼" /></Button>
					</Panel>
				</Panel>
			</Panel>
		</Panel>

		<Panel id="BattleControls" hittest="true">
			<Panel id="ShopPanel" class="ShopPanel">
				<Panel class="ShopHeaderRow">
					<Label id="ShopHeader" text="#dota2_rpg_shop_title" />
				</Panel>
				<Panel id="ShopOffer" class="ShopOffer" />
				<Panel class="ShopButtons">
					<Button id="RefreshShopButton" class="ShopButton">
						<Label id="RefreshShopLabel" text="#dota2_rpg_shop_refresh" />
					</Button>
					<Button id="BenchBuyButton" class="ShopButton">
						<Label id="BenchBuyLabel" text="#dota2_rpg_bench_buy" />
					</Button>
				</Panel>
				<Panel id="LineupPanel" class="LineupPanel">
					<Label class="LineupHeader" text="#dota2_rpg_lineup_title" />
					<Panel id="LineupStrip" class="HeroStrip" />
				</Panel>
				<Panel id="ItemShopPanel" class="LineupPanel ItemShopPanel">
					<Label class="LineupHeader" text="#dota2_rpg_item_shop" />
					<Label id="NativeShopHint" class="NativeShopHint" text="#dota2_rpg_native_shop_hint" />
					<Panel class="ItemTargetRow">
						<Label id="ItemTargetLabel" class="ItemTargetLabel" />
						<Panel id="ItemTargetHeroes" class="ItemTargetHeroes" />
					</Panel>
					<Panel id="ItemEquippedList" class="ItemEquippedList" />
					<Label class="LineupHeader" text="#dota2_rpg_item_stash" />
					<Panel id="ItemStockList" class="ItemStockList" />
					<Label class="LineupHeader" text="#dota2_rpg_scroll_shop" />
					<Panel id="ScrollShopList" class="ScrollShopList" />
				</Panel>
				</Panel>
			<Label id="VersusLabel" text="#dota2_rpg_versus" />
			<Button id="StartBattleButton">
				<Label text="#dota2_rpg_start_battle" />
			</Button>
			<Label id="ControlStatus" text="#dota2_rpg_status_preparing" />
		</Panel>

		<Panel id="DireEditor" class="TeamEditor DireEditor" hittest="true">
			<Panel class="TeamHeader">
					<Panel class="TeamIdentity">
						<Label class="TeamName" text="#dota2_rpg_dire_logic" />
						<Label id="DireTeamLevel" class="TeamLevel" text="#dota2_rpg_level_30" />
						<Label id="DireSelectedHero" class="SelectedHeroName" />
					</Panel>
				<Panel class="HeroStrip">
					<DOTAHeroImage id="DireHero1" class="HeroPortrait" heroname="npc_dota_hero_axe" heroimagestyle="portrait" hittest="true" />
					<DOTAHeroImage id="DireHero2" class="HeroPortrait" heroname="npc_dota_hero_lion" heroimagestyle="portrait" hittest="true" />
					<DOTAHeroImage id="DireHero3" class="HeroPortrait" heroname="npc_dota_hero_crystal_maiden" heroimagestyle="portrait" hittest="true" />
				</Panel>
				<Button id="DireCollapseButton" class="CollapseButton">
					<Label id="DireCollapseLabel" class="CollapseGlyph" text="&lt;" />
				</Button>
			</Panel>
			<Panel id="DireEditorBody" class="EditorBody" flow-children="down">
				<Panel class="ColumnHeader">
				<Label class="ActionColumn" text="#dota2_rpg_action_column" />
				<Label class="ConditionColumn" text="#dota2_rpg_condition_column" />
				<Label class="ForceColumn" text="#dota2_rpg_force_column" />
			</Panel>
			<Panel id="DireRulesViewport" class="RulesViewport">
				<Panel id="DireRules" class="RulesContainer" hittest="true" hittestchildren="true" />
				<Panel id="DireRulesScrollRail" class="RulesScrollRail" hittest="true">
					<Button id="DireRulesScrollUp" class="RulesScrollButton"><Label text="▲" /></Button>
					<Panel id="DireRulesScrollTrack" class="RulesScrollTrack">
						<Panel id="DireRulesScrollThumb" class="RulesScrollThumb" />
					</Panel>
					<Button id="DireRulesScrollDown" class="RulesScrollButton"><Label text="▼" /></Button>
				</Panel>
			</Panel>
				</Panel>
		</Panel>

		<Panel id="BattleResult" class="BattleResult Hidden">
			<Label id="BattleResultLabel" />
			<Label id="RewardLabel" />
		</Panel>

		<Panel id="DropdownLayer" class="DropdownLayer" />
	</Panel>
</root>
