<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/rpg_demo_hud.css" />
		<include src="file://{resources}/styles/custom_game/issue_fixes_ui.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/condition_catalog.js" />
        <include src="file://{resources}/scripts/custom_game/skill_condition_presets.js" />
		<include src="file://{resources}/scripts/custom_game/panorama_rule_sync.js" />
		<include src="file://{resources}/scripts/custom_game/issue_fixes_ui.js" />
		<include src="file://{resources}/scripts/custom_game/rpg_demo_hud.js" />
	</scripts>

	<Panel class="RpgDemoHudRoot" hittest="false">
        <Label id="RuleSyncNotice" class="RuleSyncNotice" text="" visible="false" hittest="false" />
		<Panel id="RunLivesPanel" hittest="false" hittestchildren="false">
			<Label id="RunLivesTitle" text="#dota2_rpg_lives_title" />
			<Panel id="RunLivesRow">
				<Panel id="RunHearts" />
				<Label id="RunLivesCount" text="5 / 5" />
			</Panel>
			<Label id="RunLivesHint" text="#dota2_rpg_lives_hint" />
		</Panel>
		<Panel id="BattleHeader">
			<Label id="BattleTitle" text="#dota2_rpg_battle_title" />
			<Label id="LevelProgress" text="1/20" />
			<Label id="BuildTag" text="#dota2_rpg_build_tag" />
			<Label id="WalletBalance" text="" hittest="false" />
			<Label id="BattleCountdown" text="2:00" hittest="false" />
			<Label id="BattleStatus" text="#dota2_rpg_status_preparing" />
		</Panel>

		<Panel id="RadiantEditor" class="TeamEditor RadiantEditor" hittest="true">
			<Panel class="TeamHeader">
				<Panel class="TeamIdentity">
					<Label class="TeamName" text="#dota2_rpg_radiant_logic" />
					<Label id="RadiantTeamLevel" class="TeamLevel" text="#dota2_rpg_level_30" />
					<Label id="RadiantSelectedHero" class="SelectedHeroName" />
				</Panel>
				<Panel id="RadiantHeroStrip" class="HeroStrip" />
				<Button id="RadiantCollapseButton" class="CollapseButton">
					<Label id="RadiantCollapseLabel" class="CollapseGlyph" text="&lt;" />
				</Button>
			</Panel>
			<Panel id="RadiantEditorBody" class="EditorBody" flow-children="down">
				<Panel class="ColumnHeader">
					<Label class="ActionColumn" text="#dota2_rpg_action_column" />
				</Panel>
				<Panel id="RadiantRulesViewport" class="RulesViewport">
					<Panel id="RadiantRules" class="RulesContainer" hittest="true" hittestchildren="true" />
					<Panel id="RadiantRulesScrollRail" class="RulesScrollRail" hittest="true">
						<Button id="RadiantRulesScrollUp" class="RulesScrollButton"><Label text="▲" /></Button>
						<Panel id="RadiantRulesScrollTrack" class="RulesScrollTrack">
							<Panel id="RadiantRulesScrollThumb" class="RulesScrollThumb" />
						</Panel>
						<Button id="RadiantRulesScrollDown" class="RulesScrollButton"><Label text="▼" /></Button>
					</Panel>
				</Panel>
			</Panel>
		</Panel>

		<Panel id="BattleControls" hittest="true">
			<Panel id="ShopPanel" class="ShopPanel">
				<Panel class="ShopHeaderRow">
					<Label id="ShopHeader" text="#dota2_rpg_shop_title" />
				</Panel>
				<Panel id="ShopOffer" class="ShopOffer" />
				<Panel class="ShopButtons">
					<Button id="RefreshShopButton" class="ShopButton">
						<Label id="RefreshShopLabel" text="#dota2_rpg_shop_refresh" />
					</Button>
					<Button id="BenchBuyButton" class="ShopButton">
						<Label id="BenchBuyLabel" text="#dota2_rpg_bench_buy" />
					</Button>
				</Panel>
				<Panel id="LineupPanel" class="LineupPanel">
					<Label class="LineupHeader" text="#dota2_rpg_lineup_title" />
					<Panel id="LineupStrip" class="HeroStrip" />
				</Panel>
			</Panel>
			<Label id="VersusLabel" text="#dota2_rpg_versus" />
			<Button id="StartBattleButton">
				<Label text="#dota2_rpg_start_battle" />
			</Button>
			<Label id="ControlStatus" text="#dota2_rpg_status_preparing" />
		</Panel>

		<Button id="RadiantRestoreButton" class="EditorRestoreButton RadiantRestore" visible="false" hittest="true">
			<Label text="&gt;" hittest="false" />
		</Button>

		<Panel id="RightSidebar" hittest="false" hittestchildren="true">
			<Panel id="DamagePanel" class="DamagePanel" hittest="true">
				<Panel class="SidePanelHeader">
					<Label id="DamageTitle" class="DamageTitle" text="DPS" />
					<Button id="DamageToggle" class="SidePanelToggle">
						<Label id="DamageToggleLabel" text="−" />
					</Button>
				</Panel>
				<Panel id="DamageBody" class="SidePanelBody">
					<Panel class="DamageTabs">
						<Button id="DamageFriendly">
							<Label text="#dota2_rpg_damage_friendly" />
						</Button>
						<Button id="DamageEnemy">
							<Label text="#dota2_rpg_damage_enemy" />
						</Button>
					</Panel>
					<Panel id="DamageUnits" class="DamageUnits" />
					<Label id="DamageSelection" class="DamageTitle" />
					<Panel id="DamageSources" class="DamageSources" />
					<Label id="DamageTargetsTitle" class="DamageTitle" />
					<Panel id="DamageTargets" class="DamageTargets" />
				</Panel>
			</Panel>
			<Panel id="ItemShopPanel" class="ItemShopPanel">
				<Panel class="SidePanelHeader">
					<Label class="LineupHeader" text="#dota2_rpg_item_shop" />
					<Button id="EquipmentToggle" class="SidePanelToggle">
						<Label id="EquipmentToggleLabel" text="−" />
					</Button>
				</Panel>
				<Panel id="EquipmentBody" class="SidePanelBody">
					<Label id="NativeShopHint" class="NativeShopHint" text="#dota2_rpg_native_shop_hint" />
					<Label id="ItemSellNotice" class="ItemSellNotice Hidden" text="" />
					<Panel class="ItemTargetRow">
						<Label id="ItemTargetLabel" class="ItemTargetLabel" />
						<Panel id="ItemTargetHeroes" class="ItemTargetHeroes" />
					</Panel>
					<Panel id="ItemEquippedList" class="ItemEquippedList" />
					<Label class="LineupHeader" text="#dota2_rpg_item_stash" />
					<Panel id="ItemStockList" class="ItemStockList" />
					<Label class="LineupHeader" text="#dota2_rpg_scroll_shop" />
					<Panel id="ScrollShopList" class="ScrollShopList" />
				</Panel>
			</Panel>
		</Panel>
		<Panel id="BattleResult" class="BattleResult Hidden" hittest="true">
			<Label id="BattleResultLabel" />
			<Label id="RewardLabel" />
			<Panel id="LootPopup" class="LootPopup Hidden" hittest="true">
				<Label class="LootPopupTitle" text="#dota2_rpg_loot_title" />
				<Panel id="LootPopupItems" class="LootPopupItems" />
				<Button id="LootPopupConfirm" class="LootPopupConfirm"><Label text="#dota2_rpg_loot_confirm" /></Button>
				<Label class="LootPopupHint" text="#dota2_rpg_loot_hint" />
			</Panel>
		</Panel>
		<Panel id="DropdownLayer" class="DropdownLayer" hittest="false" hittestchildren="true" />
		<Panel id="RuleSettings" class="RuleSettings Hidden">
			<Panel class="RuleSettingsCard">
				<Label class="V2Title" text="#dota2_rpg_v2_settings" />
				<Label class="V2Hint" text="#dota2_rpg_v2_intro" />
				<Panel id="RuleSettingsBody" class="RuleSettingsBody" />
				<Label id="RuleSettingsError" class="V2Error" />
				<Panel class="V2Footer">
					<Button id="RuleSettingsClose" class="V2Button"><Label text="#dota2_rpg_v2_cancel" /></Button>
					<Button id="RuleSettingsApply" class="V2Button"><Label text="#dota2_rpg_v2_apply" /></Button>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
